{
  "name": "factoryerp",
  "version": "1.0.0",
  "description": "FactoryERP: a manufacturing ERP web app (stock, BOM & routing, quotes to cash, work orders, MRP planning, ledger, people).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "reset-db": "node --no-warnings=ExperimentalWarning server/seed.js --reset",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 test/*.test.js",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://factoryerp:factoryerp@localhost/factoryerp_test} node --no-warnings=ExperimentalWarning --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^6.0.7"
  }
}
